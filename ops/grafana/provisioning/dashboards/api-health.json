{
  "uid": "parkspot-backend",
  "title": "ParkSpot Backend",
  "tags": ["parkspot"],
  "timezone": "browser",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "route",
        "label": "Route",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(parkspot_http_request_duration_seconds_count, route)",
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": true,
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "API Health",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(parkspot_http_request_duration_seconds_count{route=~\"$route\"}[15m])) * 60",
          "legendFormat": "requests/min"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Error rate (5xx)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "(sum(rate(parkspot_http_request_duration_seconds_count{route=~\"$route\", status=\"5xx\"}[15m])) or vector(0)) / sum(rate(parkspot_http_request_duration_seconds_count{route=~\"$route\"}[15m])) * 100",
          "legendFormat": "5xx rate"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latency (p50 / p95 / p99)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.5, sum(rate(parkspot_http_request_duration_seconds_bucket{route=~\"$route\"}[15m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(parkspot_http_request_duration_seconds_bucket{route=~\"$route\"}[15m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum(rate(parkspot_http_request_duration_seconds_bucket{route=~\"$route\"}[15m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 200,
      "type": "row",
      "title": "By Route",
      "collapsed": true,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "panels": [
        {
          "id": 4,
          "type": "table",
          "title": "Busiest routes",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "gridPos": { "h": 8, "w": 8, "x": 0, "y": 10 },
          "fieldConfig": {
            "defaults": { "unit": "short" },
            "overrides": [
              {
                "matcher": { "id": "byName", "options": "Value" },
                "properties": [{ "id": "displayName", "value": "Requests/min" }]
              }
            ]
          },
          "options": {
            "sortBy": [{ "displayName": "Requests/min", "desc": true }]
          },
          "targets": [
            {
              "refId": "A",
              "datasource": { "type": "prometheus", "uid": "prometheus" },
              "format": "table",
              "instant": true,
              "expr": "topk(10, sum by (route) (rate(parkspot_http_request_duration_seconds_count[15m])) * 60)"
            }
          ]
        },
        {
          "id": 5,
          "type": "table",
          "title": "Slowest routes (p95)",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "gridPos": { "h": 8, "w": 8, "x": 8, "y": 10 },
          "fieldConfig": {
            "defaults": { "unit": "s" },
            "overrides": [
              {
                "matcher": { "id": "byName", "options": "Value" },
                "properties": [{ "id": "displayName", "value": "p95 latency" }]
              }
            ]
          },
          "options": {
            "sortBy": [{ "displayName": "p95 latency", "desc": true }]
          },
          "targets": [
            {
              "refId": "A",
              "datasource": { "type": "prometheus", "uid": "prometheus" },
              "format": "table",
              "instant": true,
              "expr": "topk(10, histogram_quantile(0.95, sum by (route, le) (rate(parkspot_http_request_duration_seconds_bucket[15m]))))"
            }
          ]
        },
        {
          "id": 6,
          "type": "table",
          "title": "Routes with most 5xx",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "gridPos": { "h": 8, "w": 8, "x": 16, "y": 10 },
          "fieldConfig": {
            "defaults": { "unit": "short" },
            "overrides": [
              {
                "matcher": { "id": "byName", "options": "Value" },
                "properties": [{ "id": "displayName", "value": "5xx/min" }]
              }
            ]
          },
          "options": {
            "sortBy": [{ "displayName": "5xx/min", "desc": true }]
          },
          "targets": [
            {
              "refId": "A",
              "datasource": { "type": "prometheus", "uid": "prometheus" },
              "format": "table",
              "instant": true,
              "expr": "topk(10, sum by (route) (rate(parkspot_http_request_duration_seconds_count{status=\"5xx\"}[15m])) * 60)"
            }
          ]
        }
      ]
    },
    {
      "id": 300,
      "type": "row",
      "title": "Process Health",
      "collapsed": true,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 10 },
      "panels": [
        {
          "id": 7,
          "type": "timeseries",
          "title": "CPU usage",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "gridPos": { "h": 8, "w": 6, "x": 0, "y": 11 },
          "fieldConfig": {
            "defaults": { "unit": "percentunit" },
            "overrides": []
          },
          "targets": [
            {
              "refId": "A",
              "datasource": { "type": "prometheus", "uid": "prometheus" },
              "expr": "rate(process_cpu_seconds_total[5m])",
              "legendFormat": "cpu"
            }
          ]
        },
        {
          "id": 8,
          "type": "timeseries",
          "title": "Memory (RSS)",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "gridPos": { "h": 8, "w": 6, "x": 6, "y": 11 },
          "fieldConfig": {
            "defaults": { "unit": "bytes" },
            "overrides": []
          },
          "targets": [
            {
              "refId": "A",
              "datasource": { "type": "prometheus", "uid": "prometheus" },
              "expr": "process_resident_memory_bytes",
              "legendFormat": "rss"
            }
          ]
        },
        {
          "id": 9,
          "type": "timeseries",
          "title": "Goroutines",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "gridPos": { "h": 8, "w": 6, "x": 12, "y": 11 },
          "fieldConfig": {
            "defaults": { "unit": "short" },
            "overrides": []
          },
          "targets": [
            {
              "refId": "A",
              "datasource": { "type": "prometheus", "uid": "prometheus" },
              "expr": "go_goroutines",
              "legendFormat": "goroutines"
            }
          ]
        },
        {
          "id": 10,
          "type": "timeseries",
          "title": "GC pause duration",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "gridPos": { "h": 8, "w": 6, "x": 18, "y": 11 },
          "fieldConfig": {
            "defaults": { "unit": "s" },
            "overrides": []
          },
          "targets": [
            {
              "refId": "A",
              "datasource": { "type": "prometheus", "uid": "prometheus" },
              "expr": "go_gc_duration_seconds{quantile=\"0.5\"}",
              "legendFormat": "p50"
            },
            {
              "refId": "B",
              "datasource": { "type": "prometheus", "uid": "prometheus" },
              "expr": "go_gc_duration_seconds{quantile=\"1\"}",
              "legendFormat": "max"
            }
          ]
        }
      ]
    }
  ]
}
