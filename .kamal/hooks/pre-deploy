#!/usr/bin/env bash
set -euo pipefail

TUNNEL_PORT=15432

# ssh normally does connect(socket_fd, 45.77.73.20:27983)
# -L makes ssh additionally call bind(other_sock_fd, 127.0.0.1:$TUNNEL_PORT) and listen(other_sock_fd)
# this makes it so that if anything tries to connect to `127.0.0.1:$TUNNEL_PORT` locally, local ssh
# will pipe it to `127.0.0.1:5432` running in server 45.77.73.20
ssh -f -N \
  -p 27983 -i ~/.ssh/id_ed25519_parkspot-kamal \
  -L "${TUNNEL_PORT}:127.0.0.1:5432" \
  deploy@45.77.73.20

# now that we have something listening on 127.0.0.1:$TUNNEL_PORT, lets make the databaseURL
# be that address. net effect: the migrate code runs targeting 127.0.0.1:$TUNNEL_PORT. ssh will
# pipe it to 127.0.0.1:5432 on the server 45.77.73.20
TUNNELED_DATABASE_URL=$(echo "$DATABASE_URL" | sed -E 's#@[^/]+/#@127.0.0.1:'"$TUNNEL_PORT"'/#')

# --network host is necessary so that 127.0.0.1 isn't a container-specific loopback address. instead,
# it's the host loopback address
docker run --rm --network host \
  --entrypoint /usr/local/bin/migrate \
  -e DATABASE_URL="$TUNNELED_DATABASE_URL" \
  -e OAUTH_CLIENTID -e OAUTH_CLIENTSECRET -e OAUTH_REDIRECTURL -e OAUTH_SCOPE \
  -e OAUTH_AUTHURL -e OAUTH_TOKENURL -e OAUTH_ACCESSTOKEN -e OAUTH_REFRESHTOKEN \
  -e OAUTH_TOKENTYPE -e OAUTH_EXPIRY \
  "ghcr.io/dannyvelas/parkspot-backend:${KAMAL_VERSION}"
