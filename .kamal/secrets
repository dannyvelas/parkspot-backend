# ghcr.io auth: GitHub Actions' own GITHUB_TOKEN, passed into the CI job
# as KAMAL_REGISTRY_PASSWORD by .github/workflows/deploy.yml. Not pulled
# from Bitwarden; see research.md Decision 3/4.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Application + Postgres secrets, resolved at deploy time from the
# Bitwarden Secrets Manager project via the bws CLI. BWS_ACCESS_TOKEN
# comes from the CI job's own environment (GitHub Actions secret), never
# from this repo. Kamal parses this file as dotenv with inline command
# substitution, not as a bash script, and each line's $(...) appears to
# run as its own independent subprocess, so a shell variable set on one
# line isn't reliably visible to another. Fetched once to a local temp
# file instead, which every extraction line reads independently, then
# the temp file is removed on the last line.
BWS_PROJECT_ID=c902bd7c-b27c-4791-bab1-b4e5003dac58
BWS_FETCH=$(bws secret list "$BWS_PROJECT_ID" --access-token "$BWS_ACCESS_TOKEN" --output json > /tmp/kamal-bws-secrets-backend.json && echo ok)

DATABASE_URL=$(jq -r '.[] | select(.key=="DATABASE_URL") | .value' /tmp/kamal-bws-secrets-backend.json)
COOKIEDOMAIN=$(jq -r '.[] | select(.key=="COOKIEDOMAIN") | .value' /tmp/kamal-bws-secrets-backend.json)
CORSALLOWEDORIGINS=$(jq -r '.[] | select(.key=="CORSALLOWEDORIGINS") | .value' /tmp/kamal-bws-secrets-backend.json)
FRONTENDURL=$(jq -r '.[] | select(.key=="FRONTENDURL") | .value' /tmp/kamal-bws-secrets-backend.json)
TOKEN_ACCESSSECRET=$(jq -r '.[] | select(.key=="TOKEN_ACCESSSECRET") | .value' /tmp/kamal-bws-secrets-backend.json)
TOKEN_REFRESHSECRET=$(jq -r '.[] | select(.key=="TOKEN_REFRESHSECRET") | .value' /tmp/kamal-bws-secrets-backend.json)
OAUTH_CLIENTID=$(jq -r '.[] | select(.key=="OAUTH_CLIENTID") | .value' /tmp/kamal-bws-secrets-backend.json)
OAUTH_CLIENTSECRET=$(jq -r '.[] | select(.key=="OAUTH_CLIENTSECRET") | .value' /tmp/kamal-bws-secrets-backend.json)
OAUTH_REDIRECTURL=$(jq -r '.[] | select(.key=="OAUTH_REDIRECTURL") | .value' /tmp/kamal-bws-secrets-backend.json)
OAUTH_SCOPE=$(jq -r '.[] | select(.key=="OAUTH_SCOPE") | .value' /tmp/kamal-bws-secrets-backend.json)
OAUTH_AUTHURL=$(jq -r '.[] | select(.key=="OAUTH_AUTHURL") | .value' /tmp/kamal-bws-secrets-backend.json)
OAUTH_TOKENURL=$(jq -r '.[] | select(.key=="OAUTH_TOKENURL") | .value' /tmp/kamal-bws-secrets-backend.json)
OAUTH_ACCESSTOKEN=$(jq -r '.[] | select(.key=="OAUTH_ACCESSTOKEN") | .value' /tmp/kamal-bws-secrets-backend.json)
OAUTH_REFRESHTOKEN=$(jq -r '.[] | select(.key=="OAUTH_REFRESHTOKEN") | .value' /tmp/kamal-bws-secrets-backend.json)
OAUTH_TOKENTYPE=$(jq -r '.[] | select(.key=="OAUTH_TOKENTYPE") | .value' /tmp/kamal-bws-secrets-backend.json)
OAUTH_EXPIRY=$(jq -r '.[] | select(.key=="OAUTH_EXPIRY") | .value' /tmp/kamal-bws-secrets-backend.json)
POSTGRES_PASSWORD=$(jq -r '.[] | select(.key=="POSTGRES_PASSWORD") | .value' /tmp/kamal-bws-secrets-backend.json)

BWS_CLEANUP=$(rm -f /tmp/kamal-bws-secrets-backend.json && echo ok)
